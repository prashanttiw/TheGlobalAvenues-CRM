# TGA CRM frontend (React SPA) — served from the same Bluehost subdomain document root
# as crm-api/, cron/, storage/, uploads/. Copied into dist/ automatically by Vite (anything
# in public/ is copied as-is to the build output root).
#
# Job: let /crm-api, /cron, /storage, /uploads, and any real static file (JS/CSS/images)
# pass through untouched; everything else (client-side routes like /portal/student/dashboard)
# falls back to index.html so React Router can handle it — including on a hard refresh or
# direct link, which would otherwise 404 since those paths don't exist as real files.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never touch the backend, cron scripts, or private/public storage — let their own
    # .htaccess / Apache defaults handle those requests.
    RewriteCond %{REQUEST_URI} ^/crm-api/ [OR]
    RewriteCond %{REQUEST_URI} ^/cron/ [OR]
    RewriteCond %{REQUEST_URI} ^/storage/ [OR]
    RewriteCond %{REQUEST_URI} ^/uploads/
    RewriteRule ^ - [L]

    # Real files and directories (JS/CSS bundles, images, favicon, etc.) are served as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is a client-side route — serve the SPA shell.
    RewriteRule ^ index.html [L]
</IfModule>

# Disable directory listing
Options -Indexes

# Hide Apache version and OS
ServerSignature Off

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    # index.html must always be revalidated (it references hashed asset filenames);
    # hashed JS/CSS/image assets are safe to cache forever.
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Enable GZIP compression for performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
