APP_ENV=development
APP_URL=https://admin.theglobalavenues.com/crm-api
APP_FRONTEND_URL=http://localhost:3000
APP_NAME=TGA CRM API
APP_VERSION=1.0.0

DB_HOST=localhost
DB_NAME=tga_crm
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4
DB_PORT=3306

JWT_ACCESS_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_64_CHAR_RANDOM_STRING
JWT_RESET_SECRET=CHANGE_THIS_TO_ANOTHER_64_CHAR_RANDOM_STRING
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
JWT_ALGORITHM=HS256

# Generate with: php -r "echo base64_encode(random_bytes(32));"
ENCRYPTION_KEY=CHANGE_THIS_TO_BASE64_OF_32_RANDOM_BYTES

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

OTP_EXPIRY_MINUTES=10

TRUST_CLOUDFLARE_IP_HEADER=false

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://portal.theglobalavenues.com/auth/callback/google

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@theglobalavenues.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_EMAIL=noreply@theglobalavenues.com
MAIL_FROM_NAME=The Global Avenues
MAIL_ENCRYPTION=tls
MAIL_FALLBACK_HOST=
# Public URL of the TGA logo used in email headers.
# Must be an HTTPS URL reachable by Gmail/Outlook servers (no localhost).
# The logo-light.png in the Vite public/ folder is deployed to Vercel automatically.
MAIL_LOGO_URL=https://theglobalavenues.com/logo-light.png

UPLOAD_MAX_SIZE_MB=10
UPLOAD_PATH=uploads
UPLOAD_ALLOWED_TYPES=application/pdf,image/jpeg,image/png,image/webp

RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_OTP_REQUESTS=3
RATE_LIMIT_OTP_WINDOW=600

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://portal.theglobalavenues.com

LOG_PATH=logs
LOG_LEVEL=debug

DRIVE_SERVICE_ACCOUNT_JSON=/home/tga/crm-api/config/drive-credentials.json
DRIVE_BACKUP_FOLDER_ID=your_google_drive_folder_id

# ── Super Admin Bootstrap ────────────────────────────────────────────────────
# These are consumed ONLY by setup_database.php (one-time setup script).
# They are never read at runtime by the API.
# Use a strong password (min 12 chars, upper+lower+digit+symbol).

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@theglobalavenues.com
SUPER_ADMIN_PHONE=+91XXXXXXXXXX
SUPER_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Second super admin is optional — leave all four blank to skip
SUPER_ADMIN_2_NAME=
SUPER_ADMIN_2_EMAIL=
SUPER_ADMIN_2_PHONE=
SUPER_ADMIN_2_PASSWORD=
