# Dependencies
node_modules/
crm-api/vendor/

# Build output
dist/
build/

# Local environment files (contain secrets — never commit)
.env
.env.*
!.env.example
crm-api/.env
crm-api/.env.*
!crm-api/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
crm-api/logs/*.log

# Tooling caches
.vite/
.turbo/
.cache/
coverage/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Kiro AI workspace files (local tooling, not project source)
.kiro/
.claude/

# Local verification artifacts
.browser-check*.png
.vite-dev*.log

# AI Research & Sandbox Directories
brain/
.gemini/
scratch/
.system_generated/

