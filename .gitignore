# Dependencies
node_modules/
crm-api/vendor/

# Build output
dist/
build/

# Local environment files (contain secrets — never commit)
.env
.env.*
!.env.example
crm-api/.env
crm-api/.env.*
!crm-api/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
crm-api/logs/*.log

# Tooling caches
.vite/
.turbo/
.cache/
coverage/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Kiro AI workspace files (local tooling, not project source)
.kiro/

# Local verification artifacts
.browser-check*.png
.vite-dev*.log

# AI Research & Sandbox Directories
brain/
.gemini/
scratch/
.system_generated/

# Process and Vite local outputs
.tmp-vite.*.log
*.err.log
*.out.log

# User uploads
crm-api/uploads/*
!crm-api/uploads/.gitkeep
!crm-api/uploads/.htaccess

# Local test scripts
test_*.php
*.pyc

# Cron runtime lock file (generated at execution time, not source)
cron/scheduler.lock
