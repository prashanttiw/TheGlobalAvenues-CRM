public/qa-test-doc.pdf
public/qa-test-photo.jpg

# Codex toolkit audit output (local tooling)
.codex-toolkit-audit/

# Local test scripts
test_*.php
*.pyc

# Cron runtime lock file (generated at execution time, not source)
cron/scheduler.lock

# Local manual verification checklist
manual_verification.md
